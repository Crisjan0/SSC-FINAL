<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files and directories
<FilesMatch "^\.|\.(env|xml|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
<DirectoryMatch "^\.|\.git">
    Order allow,deny
    Deny from all
</DirectoryMatch>